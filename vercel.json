{
  "version": 2,
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/index.js?__route=/api/$1"
    },
    {
      "source": "/api",
      "destination": "/index.js?__route=/api"
    },
    {
      "source": "/",
      "destination": "/index.js?__route=/"
    }
  ]
}
